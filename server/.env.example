PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/unza-venues

# Required. Use a long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Used by `npm run seed` to create the first admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
